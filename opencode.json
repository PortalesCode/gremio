{
  "$schema": "https://opencode.ai/config.json",
  "default_agent": "lead",
  "subagent_depth": 2,
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "codegraph": {
      "type": "local",
      "command": ["npx", "-y", "@colbymchenry/codegraph@1.5.0", "serve", "--mcp"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  },
  "permission": {
    "chrome-devtools*": "deny",
    "playwright*": "deny",
    "markitdown*": "deny",
    "headroom*": "deny"
  }
}
